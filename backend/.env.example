# Copy this file to ".env" and edit. Never commit ".env".

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put your real password in it.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Database name inside Atlas (created automatically on first use).
MONGODB_DB=subh_sheva

# Admin login. If ADMIN_PASSWORD is empty, a random password is generated
# on first start and printed once in the server console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional. Leave empty and the app keeps a random signing key in the database.
SECRET_KEY=

# Public URL of the website (used in payment links sent to customers).
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins (needed when the API has a different address).
CORS_ORIGINS=http://localhost:5173
# Set to 1 on hosts that pass the visitor IP in X-Forwarded-For (Vercel, Render).
TRUST_PROXY=

# Payment: customers get a page with a "Pay with UPI" button.
UPI_ID=
PAYEE_NAME=Subh Sheva Sansthan

# Notifications: none | twilio
# "none" = nothing is sent automatically, the admin gets a WhatsApp click-to-send link.
NOTIFY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
