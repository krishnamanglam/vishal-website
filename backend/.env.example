# Copy this file to ".env" and edit. Never commit ".env".

# Admin login. If ADMIN_PASSWORD is empty, a random password is generated
# on first start and printed once in the server console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public URL of the website (used in payment links sent to customers).
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins (dev only).
CORS_ORIGINS=http://localhost:5173

# Payment: customers get a page with a "Pay with UPI" button.
UPI_ID=
PAYEE_NAME=Subh Sheva Sansthan

# Notifications: none | twilio
# "none" = nothing is sent automatically, the admin gets a WhatsApp click-to-send link.
NOTIFY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
